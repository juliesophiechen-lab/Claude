# Copy this file to .env in the same folder (.local/.env) and fill in your own
# Google Maps API key from the Google Cloud Console:
# APIs & Services > Credentials > Create credentials > API key
# Make sure the "Maps JavaScript API" is enabled for the project, and (once
# you know your deployed domain) restrict the key to that HTTP referrer.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
